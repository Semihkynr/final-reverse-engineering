# ============================================================
# Reverse Engineering Framework — Environment Variables
# BGT210 · Istinye University · Semih Kaynar
# ============================================================
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun.
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to version control!
# ============================================================

# --- Analysis Settings / Analiz Ayarları ---

# Maximum file size to analyze (bytes) / Analiz edilecek maksimum dosya boyutu
MAX_FILE_SIZE=52428800

# Output directory for reports / Raporların kaydedileceği dizin
REPORT_OUTPUT_DIR=./reports

# Sample input directory / Analiz edilecek örnek dizini
SAMPLE_INPUT_DIR=./samples

# Temporary working directory / Geçici çalışma dizini
TEMP_DIR=./tmp

# --- VirusTotal API (Optional / İsteğe Bağlı) ---
# Get your API key from: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
VIRUSTOTAL_ENABLED=false

# --- YARA Rules Directory ---
YARA_RULES_DIR=./yara_rules

# --- Logging ---
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
LOG_FILE=./logs/analyzer.log

# --- Docker / Network Settings ---
# Internal network name (do not expose to host network in production)
ANALYSIS_NETWORK=analysis_isolated

# INetSim gateway IP (for network monitoring in sandbox)
INETSIM_HOST=172.20.0.2
INETSIM_PORT=80

# --- Report Settings ---
# Report format: markdown | json | both
REPORT_FORMAT=both

# Include raw strings in report (can be large)
INCLUDE_RAW_STRINGS=false

# Maximum strings to include in report
MAX_STRINGS_IN_REPORT=100
